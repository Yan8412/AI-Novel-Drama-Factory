# 复制为 .env 后填写。不要提交真实密钥。
# Copy to .env and fill in. Never commit real secrets.
# 用法: uv run --env-file .env drama-factory demo
#
# 从 mock 切到 cloud / Comfy：只改本文件的 *_ENGINE，并在本地填写对应密钥。
# CI 与默认 demo 保持全部 = mock，不访问网络、不需要 Redis。

# ---- 引擎选择 ----
# CI 与 `drama-factory demo` 默认全部为 mock，不访问网络、不需要密钥。
# NOVEL_ENGINE: mock | cloud
#   cloud 走 OpenAI 兼容 Chat Completions（DeepSeek / Qwen 等只需改 BASE_URL + MODEL）
NOVEL_ENGINE=mock
# REVIEW_ENGINE: mock | llm_judge
REVIEW_ENGINE=mock
# STORYBOARD_ENGINE: mock | structured | cloud
#   mock       — 每章固定 3 个 9:16 镜头（CI / demo 基线）
#   structured — 离线按字数密度切短剧节拍（不访问网络）
#   cloud      — OpenAI 兼容 JSON 分镜（失败时回退 structured）
STORYBOARD_ENGINE=mock
# VISION_ENGINE: mock | cloud | comfy
#   mock  — mock:// 占位图 + 结构化九视图/场景多视图提示词
#   cloud — OpenAI 兼容 /images/generations（需 OPENAI_API_KEY）
#   comfy / comfyui — 仅 HTTP POST /prompt，不 vendor ComfyUI 源码
VISION_ENGINE=mock
# VIDEO_ENGINE: mock | cloud | comfy
#   mock  — mock:// 占位片段 + 导出 videos/*.mp4 文本桩（CI / demo）
#   cloud / openai / kling / runway / cloud:<provider>
#           OpenAI 兼容 POST /videos（见 README 请求形状）
#   comfy / comfyui / wan — 仅 HTTP POST /prompt，提交 workflows/wan21_i2v.json 桩
VIDEO_ENGINE=mock
# ASSEMBLE_ENGINE: mock | ffmpeg
#   mock   — concat 清单 + ASCII episode 桩（CI / demo）
#   ffmpeg — 若 PATH 上有 ffmpeg 且片段是真实媒体则真正拼接；否则仍写清单 + 命令
ASSEMBLE_ENGINE=mock
# TTS_ENGINE: mock | off | openai
#   mock   — episode/tts/*.json 旁路文件，不合成音频
#   off    — 不写配音
#   openai — POST {TTS_BASE_URL}/audio/speech（需密钥，失败回退 mock，不阻断导出）
TTS_ENGINE=mock
# SUBTITLE_FORMAT: both | srt | vtt | off
SUBTITLE_FORMAT=both
# 三层审核共用重试上限（REVIEW_MAX_RETRIES 为同义）。人工覆盖见 README。
REVIEW_MAX_ATTEMPTS=3
# REVIEW_MAX_RETRIES=3
# REVIEW_OVERRIDE=pass
# REVIEW_OVERRIDE_FILE=overrides.json
OUTPUT_DIR=output

# ---- 任务队列 (Phase 5) ----
# JOB_QUEUE: auto | memory | redis
#   auto   — Redis 可达则 RQ 入队；否则同步内存回退（CI / 本地无 Redis）
#   memory — 始终在 API 进程内同步执行，不需要 worker
#   redis  — 必须连上 REDIS_URL，否则 API 启动失败
# 有 Redis 时另开: docker compose up -d && uv run drama-factory-worker
JOB_QUEUE=auto
REDIS_URL=redis://127.0.0.1:6379/0
# 可选：额外 CORS 来源（逗号分隔）。默认已允许 localhost Vite / API。
# CORS_ORIGINS=http://localhost:5173

# 可选实机测试（切勿在 CI 打开；会打真实网关 / 本地 Comfy / Redis）
# RUN_LIVE_LLM=1
# RUN_LIVE_VIDEO=1
# RUN_LIVE_VISION=1
# RUN_LIVE_COMFY=1
# RUN_LIVE_REDIS=1

# ---- 云端 LLM (Phase 1/2) ----
# NOVEL_ENGINE=cloud、REVIEW_ENGINE=llm_judge 或 STORYBOARD_ENGINE=cloud 时需要。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
NOVEL_MODEL=gpt-4o-mini
REVIEW_MODEL=gpt-4o-mini
STORYBOARD_MODEL=gpt-4o-mini
# 图像 API 模型名（VISION_ENGINE=cloud）
VISION_MODEL=gpt-image-1
# 可选：逗号分隔的小说禁词（规则审核桩，默认空）
# REVIEW_BANLIST=

# DeepSeek 示例:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# NOVEL_MODEL=deepseek-chat
# REVIEW_MODEL=deepseek-chat
# STORYBOARD_MODEL=deepseek-chat
# 通义千问兼容模式示例:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NOVEL_MODEL=qwen-plus
# REVIEW_MODEL=qwen-plus
# STORYBOARD_MODEL=qwen-plus

# ---- 本地图像/视频 (Phase 2/3) ----
COMFYUI_URL=http://127.0.0.1:8188
WEIGHTS_DIR=./weights

# ---- 云端 I2V (Phase 3) ----
# VIDEO_ENGINE=cloud 时使用。未设 VIDEO_API_KEY 则回退 OPENAI_API_KEY。
# VIDEO_BASE_URL 未设则回退 OPENAI_BASE_URL。
VIDEO_MODEL=sora-2
# VIDEO_API_KEY=
# VIDEO_BASE_URL=https://api.openai.com/v1
# 兼容网关示例（把原生 Kling / Runway 包一层成 POST /videos）:
# VIDEO_ENGINE=cloud:kling
# KLING_API_KEY=your-key-here
# VIDEO_ENGINE=cloud:runway
# RUNWAY_API_KEY=your-key-here

# ---- 可选 TTS (Phase 4) ----
# TTS_ENGINE=openai 时使用。未设 TTS_API_KEY 则回退 OPENAI_API_KEY。
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# TTS_API_KEY=
# TTS_BASE_URL=

# ---- 配额 / 单价 (Phase 7) ----
# 默认单价（USD）。mock / structured / ffmpeg / comfy 记 0 费用，不受硬配额拦截。
# live API 若返回 usage（如 Chat Completions 的 usage.total_tokens）则记 recorded；
# 否则按产出量估算 token / 图像 / 视频秒 / TTS 字，再乘单价。
PRICE_TOKEN_PER_1K_USD=0.00015
PRICE_IMAGE_USD=0.04
PRICE_VIDEO_PER_SECOND_USD=0.10
PRICE_TTS_PER_1K_CHARS_USD=0.015
FX_CNY_PER_USD=7.2
QUOTA_CURRENCY=USD
# 软警告阈值（空=关闭）。超过后 API / 工作台提示，仍允许入队。
# QUOTA_SOFT_USD=
# 硬上限（空=关闭）。超过后拒绝入队 cloud / llm_judge / openai TTS 等付费引擎。
# QUOTA_MAX_USD=
