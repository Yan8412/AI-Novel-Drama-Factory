# 复制为 .env 后填写。不要提交真实密钥。
# Copy to .env and fill in. Never commit real secrets.
# 用法: uv run --env-file .env drama-factory demo

# ---- 引擎选择 ----
# CI 与 `drama-factory demo` 默认全部为 mock，不访问网络、不需要密钥。
# NOVEL_ENGINE: mock | cloud
#   cloud 走 OpenAI 兼容 Chat Completions（DeepSeek / Qwen 等只需改 BASE_URL + MODEL）
NOVEL_ENGINE=mock
# REVIEW_ENGINE: mock | llm_judge
REVIEW_ENGINE=mock
# STORYBOARD_ENGINE: mock | structured | cloud
#   mock       — 每章固定 3 个 9:16 镜头（CI / demo 基线）
#   structured — 离线按字数密度切短剧节拍（不访问网络）
#   cloud      — OpenAI 兼容 JSON 分镜（失败时回退 structured）
STORYBOARD_ENGINE=mock
# VISION_ENGINE: mock | cloud | comfy
#   mock  — mock:// 占位图 + 结构化九视图/场景多视图提示词
#   cloud — OpenAI 兼容 /images/generations（需 OPENAI_API_KEY）
#   comfy / comfyui — 仅 HTTP POST /prompt，不 vendor ComfyUI 源码
VISION_ENGINE=mock
# VIDEO_ENGINE: mock | cloud | comfy
#   mock  — mock:// 占位片段 + 导出 videos/*.mp4 文本桩（CI / demo）
#   cloud / openai / kling / runway / cloud:<provider>
#           OpenAI 兼容 POST /videos（见 README 请求形状）
#   comfy / comfyui / wan — 仅 HTTP POST /prompt，提交 workflows/wan21_i2v.json 桩
VIDEO_ENGINE=mock
REVIEW_MAX_ATTEMPTS=3
OUTPUT_DIR=output

# ---- 云端 LLM (Phase 1/2) ----
# NOVEL_ENGINE=cloud、REVIEW_ENGINE=llm_judge 或 STORYBOARD_ENGINE=cloud 时需要。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
NOVEL_MODEL=gpt-4o-mini
REVIEW_MODEL=gpt-4o-mini
STORYBOARD_MODEL=gpt-4o-mini
# 图像 API 模型名（VISION_ENGINE=cloud）
VISION_MODEL=gpt-image-1
# 可选：逗号分隔的小说禁词（规则审核桩，默认空）
# REVIEW_BANLIST=

# DeepSeek 示例:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# NOVEL_MODEL=deepseek-chat
# REVIEW_MODEL=deepseek-chat
# STORYBOARD_MODEL=deepseek-chat
# 通义千问兼容模式示例:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NOVEL_MODEL=qwen-plus
# REVIEW_MODEL=qwen-plus
# STORYBOARD_MODEL=qwen-plus

# ---- 本地图像/视频 (Phase 2/3) ----
COMFYUI_URL=http://127.0.0.1:8188
WEIGHTS_DIR=./weights

# ---- 云端 I2V (Phase 3) ----
# VIDEO_ENGINE=cloud 时使用。未设 VIDEO_API_KEY 则回退 OPENAI_API_KEY。
# VIDEO_BASE_URL 未设则回退 OPENAI_BASE_URL。
VIDEO_MODEL=sora-2
# VIDEO_API_KEY=
# VIDEO_BASE_URL=https://api.openai.com/v1
# 兼容网关示例（把原生 Kling / Runway 包一层成 POST /videos）:
# VIDEO_ENGINE=cloud:kling
# KLING_API_KEY=your-key-here
# VIDEO_ENGINE=cloud:runway
# RUNWAY_API_KEY=your-key-here
