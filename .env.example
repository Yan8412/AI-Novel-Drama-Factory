# 复制为 .env 后填写。不要提交真实密钥。
# Copy to .env and fill in. Never commit real secrets.
# 用法: uv run --env-file .env drama-factory demo

# ---- 引擎选择 ----
# CI 与 `drama-factory demo` 默认全部为 mock，不访问网络、不需要密钥。
# NOVEL_ENGINE: mock | cloud
#   cloud 走 OpenAI 兼容 Chat Completions（DeepSeek / Qwen 等只需改 BASE_URL + MODEL）
NOVEL_ENGINE=mock
# REVIEW_ENGINE: mock | llm_judge
REVIEW_ENGINE=mock
# STORYBOARD_ENGINE: mock | (Phase 2) llm
STORYBOARD_ENGINE=mock
# VISION_ENGINE: mock | comfyui
VISION_ENGINE=mock
# VIDEO_ENGINE: mock | wan | cloud:<provider>
VIDEO_ENGINE=mock
REVIEW_MAX_ATTEMPTS=3
OUTPUT_DIR=output

# ---- 云端 LLM (Phase 1) ----
# 仅当 NOVEL_ENGINE=cloud 或 REVIEW_ENGINE=llm_judge 时需要。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
NOVEL_MODEL=gpt-4o-mini
REVIEW_MODEL=gpt-4o-mini
# 可选：逗号分隔的小说禁词（规则审核桩，默认空）
# REVIEW_BANLIST=

# DeepSeek 示例:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# NOVEL_MODEL=deepseek-chat
# REVIEW_MODEL=deepseek-chat
# 通义千问兼容模式示例:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NOVEL_MODEL=qwen-plus
# REVIEW_MODEL=qwen-plus

# ---- 本地图像/视频 (Phase 2/3) ----
COMFYUI_URL=http://127.0.0.1:8188
WEIGHTS_DIR=./weights

# ---- 云端 I2V (Phase 3) ----
KLING_API_KEY=your-key-here
RUNWAY_API_KEY=your-key-here
