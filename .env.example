# 复制为 .env 后填写。不要提交真实密钥。
# Copy to .env and fill in. Never commit real secrets.
# 用法: uv run --env-file .env drama-factory demo

# ---- 引擎选择 (Phase 0 全部为 mock) ----
# NOVEL_ENGINE: mock | (Phase 1) openai | anthropic | deepseek | qwen
NOVEL_ENGINE=mock
# REVIEW_ENGINE: mock | (Phase 1) llm-judge
REVIEW_ENGINE=mock
# STORYBOARD_ENGINE: mock | (Phase 2) llm
STORYBOARD_ENGINE=mock
# VISION_ENGINE: mock | comfyui
VISION_ENGINE=mock
# VIDEO_ENGINE: mock | wan | cloud:<provider>
VIDEO_ENGINE=mock
REVIEW_MAX_ATTEMPTS=3
OUTPUT_DIR=output

# ---- 云端 LLM (Phase 1) ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=your-key-here
DEEPSEEK_API_KEY=your-key-here
DASHSCOPE_API_KEY=your-key-here

# ---- 本地图像/视频 (Phase 2/3) ----
COMFYUI_URL=http://127.0.0.1:8188
WEIGHTS_DIR=./weights

# ---- 云端 I2V (Phase 3) ----
KLING_API_KEY=your-key-here
RUNWAY_API_KEY=your-key-here
